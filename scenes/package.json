{
  "name": "@qontinui/studio-scenes",
  "version": "0.1.0",
  "private": true,
  "description": "Qontinui studio scene framework: trace-driven, deterministic process animations behind an engine adapter.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "studio-scenes": "./bin/studio-scenes.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "studio-scenes": "tsx src/cli/main.ts",
    "render": "tsx src/cli/main.ts render",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:golden": "vitest run --config vitest.golden.config.ts",
    "goldens:update": "UPDATE_GOLDENS=1 vitest run --config vitest.golden.config.ts tests/golden/golden.test.ts",
    "browser:ensure": "tsx scripts/ensure-browser.ts",
    "lint:selftest": "tsx scripts/lint-selftest.ts",
    "test:graph": "vitest run --config vitest.config.ts tests/unit/engine-graph.test.ts"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.15",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "@remotion/bundler": "4.0.529",
    "@remotion/player": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@remotion/bundler": "4.0.529",
    "@remotion/player": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "@types/node": "24.19.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.6",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "remotion": "4.0.529",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "3.2.7"
  }
}
